---
import BaseLayout from '../../components/BaseLayout.astro';

const description = 'note.comの記事ティザーを集約予定の空インデックスです。';
---

<BaseLayout title="Publications | Cursorvers" description={description}>
  <div class="site-mark">
    <img src="/favicon.svg" alt="" loading="eager" />
    <span>Publications</span>
  </div>
  <p class="eyebrow">記事一覧</p>
  <h1>note.comの記事ティザーを集約予定です。</h1>
  <p class="lead">
    このページは、今後note.comで公開した記事のティザーを集約するためのインデックスです。初期MVPでは個別記事を生成せず、note-first canonicalの運用に備えた空の入口として公開します。
  </p>
</BaseLayout>
